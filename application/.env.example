# Navidrome credentials (required)
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Last.fm API (https://www.last.fm/api/account/create)
LASTFM_APIKEY=
LASTFM_SECRET=

# PostgreSQL (defaults are fine for local use)
POSTGRES_USER=audiomuse
POSTGRES_PASSWORD=audiomusepassword
POSTGRES_DB=audiomusedb

# AI provider: NONE, OLLAMA, OPENAI, GEMINI, MISTRAL
AI_MODEL_PROVIDER=NONE
OPENAI_API_KEY=
OPENAI_SERVER_URL=https://openrouter.ai/api/v1/chat/completions
OPENAI_MODEL_NAME=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# CLAP text search (requires AVX2)
CLAP_ENABLED=true

# AudioMuse-AI authentication (leave blank to disable)
AUDIOMUSE_USER=
AUDIOMUSE_PASSWORD=
API_TOKEN=
JWT_SECRET=

# Google SSO for the /tools/ Web UI and Navidrome (oauth2-proxy + nginx)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# Max upload size accepted by the Web UI (bytes, default 2GB)
MAX_UPLOAD_BYTES=2147483648

# yt-dlp cookies file, used to bypass YouTube rate limiting/bot checks
YTDLP_COOKIES_HOST_PATH=./youtube-cookies.txt
